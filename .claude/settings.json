{
  "permissions": {
    "allow": [
      "Bash(go build*)",
      "Bash(go test*)",
      "Bash(go vet*)",
      "Bash(go mod*)",
      "Bash(go run*)",
      "Bash(go install*)",
      "Bash(git *)",
      "Bash(make *)",
      "Bash(ls *)",
      "Bash(wc *)"
    ],
    "deny": []
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  }
}
